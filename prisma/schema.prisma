// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  image         String?
  tenantId      String    @default("default")
  currentTeamId String?
  role          String?
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  blogPosts     BlogPost[]
  notifications AppNotification[]
  memberships   TeamMember[]
  apiKeys       ApiKey[]
  currentTeam   Team?             @relation("CurrentTeam", fields: [currentTeamId], references: [id], onDelete: SetNull)
}

model ApiKey {
  id        String    @id @default(cuid())
  userId    String
  name      String
  prefix    String    @unique
  hashedKey String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Team {
  id        String   @id @default(cuid())
  tenantId  String   @default("default")
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      TeamMember[]
  currentUsers User[]       @relation("CurrentTeam")
}

model TeamMember {
  teamId    String
  userId    String
  tenantId  String   @default("default")
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

model Session {
  id             String   @id @default(cuid())
  token          String   @unique
  userId         String
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model FeatureFlag {
  id        String   @id @default(cuid())
  key       String
  tenantId  String?
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, tenantId])
}

model AppNotification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id String @id @default(cuid())
  // createdAt is a millisecond timestamp, so two entries written in the same
  // millisecond -- routine under load -- have no order at all. Reading the
  // chain by it can hand the verifier a legitimate chain in the wrong order,
  // and reading the tail by it can return the wrong predecessor. The sequence
  // is what actually orders the chain.
  sequence       Int      @unique @default(autoincrement())
  tenantId       String
  model          String
  operation      String
  recordId       String?
  data           Json
  userId         String?
  impersonatedBy String?
  hash           String
  // Empty for the genesis entry rather than null: Postgres treats each NULL as
  // distinct, so a nullable column would have let a tenant hold any number of
  // genesis entries -- as many parallel chains -- while the constraint below
  // looked like it forbade them.
  previousHash   String
  createdAt      DateTime @default(now())

  @@index([tenantId, sequence])
  // Two entries in the same tenant's chain can never claim the same
  // predecessor -- that is a fork, and the linear verifier can never accept
  // one. With previousHash non-null this also caps a tenant at exactly one
  // genesis entry.
  @@unique([tenantId, previousHash])
}

model BlogPost {
  id        String    @id @default(cuid())
  tenantId  String
  ownerId   String
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner User           @relation(fields: [ownerId], references: [id])
  notes BlogPostNote[]
  tags  BlogPostTag[]

  @@index([tenantId])
}

// A belongsToMany relation, unlike BlogPostNote's hasMany: a tag does not
// belong to one blog post, so attaching or detaching one never creates or
// deletes a Tag row, only a row in this pivot table -- see
// relation-mutations.ts, the shared resolver every generated attach/detach/
// sync route goes through.
model BlogPostTag {
  blogPostId String
  tagId      String
  createdAt  DateTime @default(now())

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogPostId, tagId])
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  blogPosts BlogPostTag[]
}

model BlogPostNote {
  id         String   @id @default(cuid())
  blogPostId String
  body       String
  rating     Int?
  createdAt  DateTime @default(now())

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@index([blogPostId])
}

// Attachable to more than one resource type, so there is no single parent to
// point a Prisma @relation at -- commentableType carries which model
// commentableId refers to. Prisma does not model this: there is no
// referential integrity here at the database level, only at the application
// level, in list-query.ts's morphMany handling.
model Comment {
  id              String   @id @default(cuid())
  commentableType String
  commentableId   String
  body            String
  createdAt       DateTime @default(now())

  @@index([commentableType, commentableId])
}

model MailLog {
  id        String    @id @default(cuid())
  tenantId  String
  to        String
  subject   String
  status    String    @default("queued")
  error     String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([tenantId])
}

// The secret must stay readable in plaintext -- verifying an inbound
// signature means recomputing the same HMAC the sender used, so this cannot
// be a one-way hash the way a password or an API key is.
model WebhookEndpoint {
  id        String   @id @default(cuid())
  tenantId  String
  source    String
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  events WebhookEvent[]

  @@index([tenantId])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  endpointId  String
  tenantId    String
  source      String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([endpointId])
}
