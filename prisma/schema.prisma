// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  emailVerified    Boolean   @default(false)
  name             String?
  image            String?
  tenantId         String    @default("default")
  currentTeamId    String?
  role             String?
  banned           Boolean   @default(false)
  banReason        String?
  banExpires       DateTime?
  twoFactorEnabled Boolean   @default(false)
  phoneNumber      String?   @unique
  phoneNumberVerified Boolean @default(false)
  isAnonymous      Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions                  Session[]
  accounts                  Account[]
  blogPosts                 BlogPost[]
  snippets                  Snippet[]
  notifications             AppNotification[]
  memberships               TeamMember[]
  apiKeys                   ApiKey[]
  twoFactors                TwoFactor[]
  passkeys                  Passkey[]
  pushTokens                PushToken[]
  notificationPreferences   NotificationPreference[]
  notificationSetting       NotificationSetting?
  notificationDigestEntries NotificationDigestEntry[]
  twoFactorEnrolment        TwoFactorEnrolment?
  twoFactorRecoveryCodes    TwoFactorRecoveryCode[]
  twoFactorVerifiedSessions TwoFactorVerifiedSession[]
  currentTeam               Team?                      @relation("CurrentTeam", fields: [currentTeamId], references: [id], onDelete: SetNull)
}

model ApiKey {
  id        String    @id @default(cuid())
  userId    String
  name      String
  prefix    String    @unique
  hashedKey String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Team {
  id        String   @id @default(cuid())
  tenantId  String   @default("default")
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      TeamMember[]
  currentUsers User[]       @relation("CurrentTeam")
}

model TeamMember {
  teamId    String
  userId    String
  tenantId  String   @default("default")
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

model Session {
  id             String   @id @default(cuid())
  token          String   @unique
  userId         String
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model FeatureFlag {
  id        String   @id @default(cuid())
  key       String
  tenantId  String?
  enabled   Boolean  @default(false)
  // 0-100, bucketed per user or per tenant (rolloutBy); 100 means everyone.
  rolloutPercentage Int @default(100)
  rolloutBy String @default("user")
  // Ordered targeting rules, first match wins; see feature-flag-evaluation.ts.
  rules     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, tenantId])
}

model AppNotification {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
}

model AuditLog {
  id             String   @id @default(cuid())
  // createdAt is a millisecond timestamp, so two entries written in the same
  // millisecond -- routine under load -- have no order at all. Reading the
  // chain by it can hand the verifier a legitimate chain in the wrong order,
  // and reading the tail by it can return the wrong predecessor. The sequence
  // is what actually orders the chain.
  sequence       Int      @unique @default(autoincrement())
  tenantId       String
  model          String
  operation      String
  recordId       String?
  data           Json
  userId         String?
  impersonatedBy String?
  hash           String
  // Empty for the genesis entry rather than null: Postgres treats each NULL as
  // distinct, so a nullable column would have let a tenant hold any number of
  // genesis entries -- as many parallel chains -- while the constraint below
  // looked like it forbade them.
  previousHash   String
  createdAt      DateTime @default(now())

  // Two entries in the same tenant's chain can never claim the same
  // predecessor -- that is a fork, and the linear verifier can never accept
  // one. With previousHash non-null this also caps a tenant at exactly one
  // genesis entry.
  @@unique([tenantId, previousHash])
  @@index([tenantId, sequence])
}

model BlogPost {
  id        String    @id @default(cuid())
  tenantId  String
  ownerId   String
  title     String
  summary   Json?
  privateNote String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner User           @relation(fields: [ownerId], references: [id])
  notes BlogPostNote[]
  tags  BlogPostTag[]

  @@index([tenantId])
}

// A belongsToMany relation, unlike BlogPostNote's hasMany: a tag does not
// belong to one blog post, so attaching or detaching one never creates or
// deletes a Tag row, only a row in this pivot table -- see
// relation-mutations.ts, the shared resolver every generated attach/detach/
// sync route goes through.
model BlogPostTag {
  tenantId   String
  blogPostId String
  tagId      String
  createdAt  DateTime @default(now())

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogPostId, tagId])
  @@index([tenantId])
}

model Tag {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  blogPosts BlogPostTag[]

  @@index([tenantId])
}

model BlogPostNote {
  id         String   @id @default(cuid())
  tenantId   String
  blogPostId String
  body       String
  rating     Int?
  createdAt  DateTime @default(now())

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@index([blogPostId])
  @@index([tenantId])
}

// Attachable to more than one resource type, so there is no single parent to
// point a Prisma @relation at -- commentableType carries which model
// commentableId refers to. Prisma does not model this: there is no
// referential integrity here at the database level, only at the application
// level, in list-query.ts's morphMany handling.
model Comment {
  id              String   @id @default(cuid())
  tenantId        String
  commentableType String
  commentableId   String
  body            String
  createdAt       DateTime @default(now())

  @@index([commentableType, commentableId])
  @@index([tenantId])
}

model MailLog {
  id        String    @id @default(cuid())
  tenantId  String
  to        String
  subject   String
  status    String    @default("queued")
  error     String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([tenantId])
}

// The secret must stay readable in plaintext -- verifying an inbound
// signature means recomputing the same HMAC the sender used, so this cannot
// be a one-way hash the way a password or an API key is.
model WebhookEndpoint {
  id        String   @id @default(cuid())
  tenantId  String
  source    String
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  events WebhookEvent[]

  @@index([tenantId])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  endpointId  String
  tenantId    String
  source      String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([endpointId])
}

// Written in the same transaction as the change it describes, then relayed to
// handlers by a worker. tenantId is nullable because a message can be staged
// outside any request, and the relay reads across tenants, so the table sits
// outside the row-level policies the way MailLog does.
model OutboxMessage {
  id            String    @id @default(cuid())
  tenantId      String?
  name          String
  payload       Json
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  createdAt     DateTime  @default(now())
  deliveredAt   DateTime?
  deadAt        DateTime?

  receipts OutboxReceipt[]

  @@index([status, nextAttemptAt])
  @@index([status, deliveredAt])
  @@index([status, deadAt])
}

// One row per handler that finished a message, so a retry after a partial
// failure reruns only the handlers that did not.
model OutboxReceipt {
  id          String   @id @default(cuid())
  messageId   String
  handler     String
  completedAt DateTime @default(now())

  message OutboxMessage @relation(fields: [messageId], references: [id])

  @@unique([messageId, handler])
}

// Shape taken from better-auth's own two-factor plugin schema, not invented
// here: the adapter checks every field at boot and refuses the whole instance
// on a mismatch, which turns a missing column into "every registration returns
// 500" rather than into a 2FA-only failure.
model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
}

model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now())
  aaguid       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialID])
}

// Consent is recorded per number rather than per user: a number does not always
// belong to an account, and the number is what a regulator asks about. A log
// rather than a flag -- a revocation is a new row, because overwriting the
// grant erases the evidence a dispute turns on.
model SmsConsent {
  id        String   @id @default(cuid())
  tenantId  String
  phone     String
  granted   Boolean
  source    String
  createdAt DateTime @default(now())

  @@index([tenantId, phone, createdAt])
}

// One row per device, not per user: a person has a laptop, a phone and a
// tablet. lastSeenAt is what separates a token that went quiet from one that
// died -- a provider only reports a dead token in answer to a send, so a
// device nobody sends to needs a sweep of its own.
model PushToken {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  token      String   @unique
  platform   String
  lastSeenAt DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([lastSeenAt])
}

// The local truth about what a tenant is subscribed to, refreshed from the
// provider's own webhook rather than queried from it on every request. Keyed
// on (provider, providerSubscriptionId) rather than on tenantId alone: a
// tenant may hold more than one subscription, one per product sold
// separately, and a single row per tenant would make a second subscription
// overwrite the first.
model BillingSubscription {
  id                     String   @id @default(cuid())
  tenantId               String
  provider               String
  providerSubscriptionId String
  plan                   String
  status                 String
  currentPeriodEnd       DateTime
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([provider, providerSubscriptionId])
  @@index([tenantId])
}

// A limit set for one tenant, replacing the default declared under `quotas` in
// hery.config.ts. A row is an exception, so most tenants have none; the
// rate-limit guard reads `rate-limit:<bucket>` rows the same way.
model QuotaOverride {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  limit     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
}

// What a tenant has consumed of a named quota within one period. `period` is a
// key ("2026-10", "2026-10-21" or "total"), not a date, so a new period is a
// new row rather than a reset of the old one, and last month's figure stays
// readable for usage-based billing.
model QuotaUsage {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  period    String
  used      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name, period])
}

model IdempotencyKey {
  id              String    @id @default(cuid())
  tenantId        String
  key             String
  route           String
  bodyHash        String
  status          String    @default("pending")
  statusCode      Int?
  responseBody    Json?
  responseHeaders Json?
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  @@unique([tenantId, key])
  @@index([tenantId])
}

model OauthIdentity {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  email          String?
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

model TwoFactorEnrolment {
  id             String    @id @default(cuid())
  tenantId       String
  userId         String    @unique
  secret         String
  confirmedAt    DateTime?
  lastUsedStep   Int?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

model TwoFactorRoleRequirement {
  id        String   @id @default(cuid())
  tenantId  String
  role      String
  createdAt DateTime @default(now())

  @@unique([tenantId, role])
}

model TwoFactorVerifiedSession {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

model Snippet {
  id        String    @id @default(cuid())
  tenantId  String
  ownerId   String
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)

  owner User @relation(fields: [ownerId], references: [id])

  @@index([tenantId])
  // Every default read filters on these two together, so the composite keeps
  // the "not deleted" clause from scanning the whole tenant.
  @@index([tenantId, deletedAt])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  channel   String
  type      String
  enabled   Boolean  @default(true)
  digest    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, type])
  @@index([tenantId])
}

model NotificationSetting {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String   @unique
  timezone        String   @default("UTC")
  quietHoursStart String?
  quietHoursEnd   String?
  digestHour      Int      @default(8)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model NotificationDigestEntry {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  email     String
  type      String
  subject   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

model DevtoolsEntry {
  id         String   @id @default(cuid())
  tenantId   String
  kind       String
  label      String
  status     String?
  durationMs Float?
  requestId  String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, kind, createdAt])
  @@index([createdAt])
}

model SsoConnection {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  issuer       String
  clientId     String
  clientSecret String
  linkPolicy   String   @default("refuse")
  isEnabled    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  domains    SsoDomain[]
  identities SsoIdentity[]

  @@index([tenantId])
}

model SsoDomain {
  id                String    @id @default(cuid())
  tenantId          String
  connectionId      String
  domain            String
  verificationToken String
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())

  connection SsoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, domain])
  @@index([tenantId])
  @@index([domain])
}

model SsoIdentity {
  id           String   @id @default(cuid())
  tenantId     String
  connectionId String
  subject      String
  userId       String
  createdAt    DateTime @default(now())

  connection SsoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, subject])
  @@index([tenantId])
  @@index([userId])
}

model LogEntry {
  id       String   @id @default(cuid())
  tenantId String
  level    String
  message  String
  fields   Json?
  loggedAt DateTime @default(now())

  @@index([tenantId, loggedAt])
  @@index([loggedAt])
}
