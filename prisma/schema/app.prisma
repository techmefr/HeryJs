/// @hery.tenantScoped
/// @hery.audited
model BlogPost {
  id          String    @id @default(cuid())
  tenantId    String
  ownerId     String
  title       String
  slug        String    @default(cuid())
  summary     Json?
  body        String?
  /// @hery.encrypted
  privateNote String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  owner User           @relation(fields: [ownerId], references: [id])
  notes BlogPostNote[]
  tags  BlogPostTag[]

  // Unique per tenant, trashed rows included: a slug stays reserved until
  // prune frees the row.
  @@unique([tenantId, slug])
  @@index([tenantId])
}

// A belongsToMany relation, unlike BlogPostNote's hasMany: a tag does not
// belong to one blog post, so attaching or detaching one never creates or
// deletes a Tag row, only a row in this pivot table -- see
// relation-mutations.ts, the shared resolver every generated attach/detach/
// sync route goes through.
/// @hery.tenantScoped
model BlogPostTag {
  tenantId   String
  blogPostId String
  tagId      String
  createdAt  DateTime @default(now())

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogPostId, tagId])
  @@index([tenantId])
}

/// @hery.tenantScoped
model Tag {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  blogPosts BlogPostTag[]

  @@index([tenantId])
}

/// @hery.tenantScoped
model BlogPostNote {
  id         String   @id @default(cuid())
  tenantId   String
  blogPostId String
  body       String
  rating     Int?
  createdAt  DateTime @default(now())

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@index([blogPostId])
  @@index([tenantId])
}

// Attachable to more than one resource type, so there is no single parent to
// point a Prisma @relation at -- commentableType carries which model
// commentableId refers to. Prisma does not model this: there is no
// referential integrity here at the database level, only at the application
// level, in list-query.ts's morphMany handling.
/// @hery.tenantScoped
model Comment {
  id              String   @id @default(cuid())
  tenantId        String
  commentableType String
  commentableId   String
  body            String
  createdAt       DateTime @default(now())

  @@index([commentableType, commentableId])
  @@index([tenantId])
}

/// @hery.tenantScoped
model Snippet {
  id        String    @id @default(cuid())
  tenantId  String
  ownerId   String
  /// @hery.history
  title     String
  /// @hery.history
  summary   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// @hery.history
  deletedAt DateTime?
  /// @hery.history
  version   Int       @default(1)
  /// @hery.history
  status    String    @default("draft")

  owner User @relation(fields: [ownerId], references: [id])

  @@index([tenantId])
  // Every default read filters on these two together, so the composite keeps
  // the "not deleted" clause from scanning the whole tenant.
  @@index([tenantId, deletedAt])
}
