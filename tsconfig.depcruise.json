{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@heryjs/core/devtools": ["src/devtools/public"],
      "@heryjs/core/app": ["src/hery/public"],
      "@heryjs/core/*": ["src/technical/public/*"],
      "#technical/*": ["src/technical/*"],
      "#devtools/*": ["src/devtools/*"],
      "#modules/*": ["src/modules/*"],
      "#functional/*": ["src/functional/*"],
      "#app.module": ["src/app.module"]
    }
  }
}
