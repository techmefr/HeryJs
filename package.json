{
  "name": "heryjs",
  "version": "0.1.0",
  "description": "The batteries-included framework for NestJS: generate secured, multi-tenant resources from a blueprint, then own every line. Auth, RBAC, Postgres RLS, jobs, real time, vector search, OpenAPI.",
  "author": "Gaetan Compigni",
  "license": "MIT",
  "homepage": "https://techmefr.github.io/HeryJs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techmefr/HeryJs.git"
  },
  "bugs": {
    "url": "https://github.com/techmefr/HeryJs/issues"
  },
  "keywords": [
    "nestjs",
    "nestjs-framework",
    "typescript",
    "framework",
    "backend",
    "api",
    "rest-api",
    "scaffolding",
    "code-generator",
    "boilerplate",
    "prisma",
    "postgresql",
    "multi-tenant",
    "saas",
    "rbac",
    "authorization",
    "authentication",
    "row-level-security",
    "graphql",
    "mcp",
    "openapi",
    "realtime",
    "websocket",
    "bullmq",
    "cli",
    "batteries-included"
  ],
  "engines": {
    "node": ">=24.20"
  },
  "bin": {
    "heryjs": "dist/scaffold/packages/cli/src/heryjs.js"
  },
  "types": "dist/scaffold/packages/cli/src/module-contract.d.ts",
  "exports": {
    ".": {
      "types": "./dist/scaffold/packages/cli/src/module-contract.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/scaffold",
    "scripts",
    "src/devtools",
    "src/hery",
    "src/functional",
    "src/app.controller.ts",
    "src/app.controller.spec.ts",
    "src/app.module.ts",
    "src/hery.modules.ts",
    "src/app.service.ts",
    "src/create-app.ts",
    "src/main.ts",
    "test",
    ".github",
    "examples/*.yaml",
    "templates",
    "SECURITY.md",
    "CHANGELOG.md",
    "prisma/schema",
    "prisma.config.ts",
    "hery.config.ts",
    "cors.config.ts",
    ".dependency-cruiser.cjs",
    "tsconfig.json",
    "tsconfig.build.json",
    "tsconfig.depcruise.json",
    "nest-cli.json",
    "eslint.config.mjs",
    ".oxlintrc.json",
    ".prettierrc",
    ".env.example",
    ".nvmrc",
    "docker-compose.yml",
    "docker-compose.storage.yml",
    "docker-compose.stream.yml",
    "Caddyfile",
    "pnpm-workspace.yaml"
  ],
  "scripts": {
    "db:generate": "prisma generate",
    "build:core": "pnpm run build:modules",
    "build": "pnpm run build:core && nest build",
    "build:scaffold": "tsc -p tsconfig.scaffold.json",
    "build:modules": "pnpm run build:scaffold && pnpm --filter \"./packages/*\" run build",
    "prepack": "pnpm run build:scaffold",
    "format": "prettier --write \"{src,apps,libs,test,scripts,prisma,examples,packages}/**/*.ts\" \"prisma.config.ts\" \"hery.config.ts\" \"cors.config.ts\"",
    "format:check": "prettier --check \"{src,apps,libs,test,scripts,prisma,examples,packages}/**/*.ts\" \"prisma.config.ts\" \"hery.config.ts\" \"cors.config.ts\"",
    "start": "pnpm run build:core && nest start -b swc",
    "start:dev": "pnpm run build:core && nest start -b swc --watch",
    "dev:core": "tsc -p packages/core/tsconfig.build.json --watch --preserveWatchOutput",
    "start:debug": "pnpm run build:core && nest start -b swc --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "NODE_OPTIONS=--max-old-space-size=6144 eslint \"{src,apps,libs,test,scripts,prisma,examples,packages}/**/*.ts\" \"prisma.config.ts\" \"hery.config.ts\" \"cors.config.ts\" --ignore-pattern \"packages/admin-astro/src/runtime/**\" --max-warnings 0 && pnpm --filter admin lint",
    "lint:fix": "NODE_OPTIONS=--max-old-space-size=6144 eslint \"{src,apps,libs,test,scripts,prisma,examples,packages}/**/*.ts\" \"prisma.config.ts\" \"hery.config.ts\" \"cors.config.ts\" --ignore-pattern \"packages/admin-astro/src/runtime/**\" --fix && pnpm --filter admin lint:fix",
    "lint:fast": "oxlint -c .oxlintrc.json --deny-warnings src apps libs test scripts prisma prisma.config.ts hery.config.ts cors.config.ts",
    "lint:types": "oxlint -c .oxlintrc.json --type-aware --deny-warnings src apps libs test scripts prisma prisma.config.ts hery.config.ts cors.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:packages": "for d in packages/*/ examples/hery-module-*/; do if [ -f \"$d/tsconfig.json\" ]; then echo \"$d\"; tsc --noEmit -p \"$d/tsconfig.json\" || exit 1; fi; done",
    "test": "pnpm run test:app && pnpm run test:module-specs && pnpm --filter admin test",
    "test:app": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:random": "NODE_OPTIONS=--experimental-vm-modules jest --randomize --showSeed",
    "docs:examples": "DOC_EXAMPLES_WRITE=true NODE_OPTIONS=--experimental-vm-modules jest examples/blog-post/doc-examples.spec.ts",
    "test:serial": "JEST_SHARED_DB=true NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "NODE_OPTIONS=--experimental-vm-modules node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "test:modules": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-modules.json",
    "test:module-specs": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-module-specs.json",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs",
    "lint:conventions": "NODE_OPTIONS=\"--conditions=development --conditions=heryjs-source\" ts-node scripts/check-conventions.ts",
    "lint:admin-contract": "pnpm run lint:conventions admin-contract",
    "lint:capabilities": "pnpm run lint:conventions capabilities",
    "lint:scope-parity": "pnpm run lint:conventions scope-parity",
    "lint:rls": "pnpm run lint:conventions rls",
    "lint:pagination": "pnpm run lint:conventions pagination",
    "lint:rate-limit": "pnpm run lint:conventions rate-limit",
    "lint:module-drift": "pnpm run lint:conventions module-drift",
    "lint:no-raw-pii-log": "pnpm run lint:conventions no-raw-pii-log",
    "lint:module-validity": "pnpm run lint:conventions module-validity",
    "lint:module-patches": "pnpm run lint:conventions module-patches",
    "lint:module-destinations": "pnpm run lint:conventions module-destinations",
    "lint:coverage": "pnpm run lint:conventions coverage",
    "lint:dev-guard": "pnpm run lint:conventions dev-guard",
    "lint:no-fixed-sleeps": "pnpm run lint:conventions no-fixed-sleeps",
    "lint:subject": "pnpm run lint:conventions subject",
    "lint:template-imports": "pnpm run lint:conventions template-imports",
    "lint:tenant-isolation": "pnpm run lint:conventions tenant-isolation",
    "lint:kernel-version": "pnpm run lint:conventions kernel-version",
    "lint:kernel-boundary": "pnpm run lint:conventions kernel-boundary",
    "lint:kernel-versions": "pnpm run lint:conventions kernel-versions",
    "kernel:versions": "NODE_OPTIONS=\"--conditions=development --conditions=heryjs-source\" ts-node scripts/check-kernel-versions.ts --write",
    "lint:package-manifests": "pnpm run lint:conventions package-manifests",
    "lint:example": "pnpm run lint:conventions example-freshness",
    "lint:hery": "NODE_OPTIONS=\"--conditions=development --conditions=heryjs-source\" ts-node packages/cli/src/hery.ts lint --min-score 100",
    "hery": "NODE_OPTIONS=\"--conditions=development --conditions=heryjs-source\" ts-node packages/cli/src/hery.ts",
    "codemod:kernel": "pnpm hery kernel:migrate packages examples --peer workspace:^"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@better-auth/passkey": "1.7.3",
    "@bull-board/api": "^9.8.0",
    "@bull-board/express": "^9.8.0",
    "@heryjs/billing": "workspace:*",
    "@heryjs/core": "workspace:*",
    "@heryjs/embeddings": "workspace:*",
    "@heryjs/export": "workspace:*",
    "@heryjs/impersonation": "workspace:*",
    "@heryjs/live": "workspace:*",
    "@heryjs/mail": "workspace:*",
    "@heryjs/notifier": "workspace:*",
    "@heryjs/oauth": "workspace:*",
    "@heryjs/push": "workspace:*",
    "@heryjs/scim": "workspace:*",
    "@heryjs/sms": "workspace:*",
    "@heryjs/sse": "workspace:*",
    "@heryjs/sso": "workspace:*",
    "@heryjs/storage": "workspace:*",
    "@heryjs/stream": "workspace:*",
    "@heryjs/two-factor": "workspace:*",
    "@heryjs/webhooks": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "@nestjs/websockets": "^12.0.1",
    "@node-saml/node-saml": "^5.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prometheus-io/client": "^0.16.1",
    "@xmldom/xmldom": "^0.8.15",
    "better-auth": "^1.7.3",
    "bullmq": "^6.3.4",
    "commander": "^15.0.0",
    "cron": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "js-yaml": "^5.4.1",
    "livekit-server-sdk": "^2.18.0",
    "nestjs-pino": "^5.1.0",
    "pg": "^8.23.0",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prompts": "^2.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "2.18.1",
    "semver": "^7.8.5",
    "socket.io": "^4.8.3",
    "xpath": "^0.0.34",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@heryjs/cli": "workspace:*",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/prompts": "^2.4.9",
    "@types/sanitize-html": "^2.16.2",
    "@types/semver": "^7.8.0",
    "@types/supertest": "^7.0.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "xml-crypto": "^6.4.0"
  },
  "packageManager": "pnpm@11.9.0",
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "globalSetup": "<rootDir>/test/parallel-setup.ts",
    "globalTeardown": "<rootDir>/test/parallel-teardown.ts",
    "setupFiles": [
      "<rootDir>/test/parallel-env.ts"
    ],
    "maxWorkers": 4,
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "testTimeout": 15000,
    "forceExit": true,
    "roots": [
      "<rootDir>/src",
      "<rootDir>/packages/cli",
      "<rootDir>/examples"
    ],
    "moduleNameMapper": {
      "^@heryjs/core/devtools$": "<rootDir>/src/devtools/public",
      "^@heryjs/core/conventions$": "<rootDir>/src/devtools/conventions/index",
      "^@heryjs/core/app$": "<rootDir>/src/hery/public",
      "^@heryjs/core/technical/(.*)$": "<rootDir>/src/technical/$1",
      "^@heryjs/cli/(.*)$": "<rootDir>/packages/cli/src/$1",
      "^@heryjs/core/(.*)$": "<rootDir>/src/technical/public/$1",
      "^#kernel/(.*)$": "<rootDir>/src/technical/$1",
      "^#technical/(.*)$": "<rootDir>/src/technical/$1",
      "^#devtools/(.*)$": "<rootDir>/src/devtools/$1",
      "^@heryjs/(?!core/|cli/)([^/]+)/hery$": "<rootDir>/packages/$1/src/runtime/$1.hery",
      "^@heryjs/(?!core/|cli/)([^/]+)/(.*)$": "<rootDir>/packages/$1/src/runtime/$2",
      "^#modules/([^/]+)/(.*)$": "<rootDir>/packages/$1/src/runtime/$2",
      "^#functional/(.*)$": "<rootDir>/src/functional/$1",
      "^#app\\.module$": "<rootDir>/src/app.module"
    }
  },
  "imports": {
    "#technical/*": {
      "types": "./src/technical/*.ts",
      "development": "./src/technical/*.ts",
      "default": "./dist/src/technical/*.js"
    },
    "#devtools/*": {
      "types": "./src/devtools/*.ts",
      "development": "./src/devtools/*.ts",
      "default": "./dist/src/devtools/*.js"
    },
    "#modules/*": "@heryjs/*",
    "#functional/*": {
      "types": "./src/functional/*.ts",
      "development": "./src/functional/*.ts",
      "default": "./dist/src/functional/*.js"
    },
    "#app.module": {
      "types": "./src/app.module.ts",
      "development": "./src/app.module.ts",
      "default": "./dist/src/app.module.js"
    }
  }
}
