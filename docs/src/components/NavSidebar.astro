---
// Starlight's own SidebarSublist doesn't support per-item icons (only a text
// badge, checked in its schema), so the audience-level groups this doc site
// pivots on -- Backend, Frontend, Debug -- get a small override here instead
// of a fork of the whole component. Everything below top level renders
// exactly as Starlight's default SidebarSublist does.
import SidebarRestorePoint from '@astrojs/starlight/components/SidebarRestorePoint.astro';
import serverIcon from 'lucide-static/icons/server.svg?raw';
import monitorIcon from 'lucide-static/icons/monitor.svg?raw';
import bugIcon from 'lucide-static/icons/bug.svg?raw';
import caretIcon from 'lucide-static/icons/chevron-right.svg?raw';
import rocketIcon from 'lucide-static/icons/rocket.svg?raw';
import folderTreeIcon from 'lucide-static/icons/folder-tree.svg?raw';
import keyRoundIcon from 'lucide-static/icons/key-round.svg?raw';
import shieldCheckIcon from 'lucide-static/icons/shield-check.svg?raw';
import usersIcon from 'lucide-static/icons/users.svg?raw';
import buildingIcon from 'lucide-static/icons/building-2.svg?raw';
import triangleAlertIcon from 'lucide-static/icons/triangle-alert.svg?raw';
import terminalIcon from 'lucide-static/icons/terminal.svg?raw';
import fileTextIcon from 'lucide-static/icons/file-text.svg?raw';
import fileCodeIcon from 'lucide-static/icons/file-code.svg?raw';
import flaskIcon from 'lucide-static/icons/flask-conical.svg?raw';
import puzzleIcon from 'lucide-static/icons/puzzle.svg?raw';
import searchIcon from 'lucide-static/icons/search.svg?raw';
import radioIcon from 'lucide-static/icons/radio.svg?raw';
import mailIcon from 'lucide-static/icons/mail.svg?raw';
import userCogIcon from 'lucide-static/icons/user-cog.svg?raw';
import shareIcon from 'lucide-static/icons/share-2.svg?raw';
import layoutDashboardIcon from 'lucide-static/icons/layout-dashboard.svg?raw';
import bookOpenIcon from 'lucide-static/icons/book-open.svg?raw';
import fileSearchIcon from 'lucide-static/icons/file-search.svg?raw';
import pencilIcon from 'lucide-static/icons/pencil.svg?raw';
import trashIcon from 'lucide-static/icons/trash-2.svg?raw';
import wrenchIcon from 'lucide-static/icons/wrench.svg?raw';
import activityIcon from 'lucide-static/icons/activity.svg?raw';

const TOP_LEVEL_ICONS: Record<string, string> = {
	Backend: serverIcon,
	Frontend: monitorIcon,
	Debug: bugIcon,
};

// Leaf pages get their own icon too, keyed by the sidebar label in
// astro.config.mjs -- there is no per-item icon field in Starlight's sidebar
// schema (only a text badge), so this is the same override pattern as
// TOP_LEVEL_ICONS, just applied one level down.
const LEAF_ICONS: Record<string, string> = {
	Introduction: rocketIcon,
	'Project structure': folderTreeIcon,
	Authentication: keyRoundIcon,
	Capabilities: shieldCheckIcon,
	Teams: usersIcon,
	'Multi-tenancy': buildingIcon,
	'Errors and responses': triangleAlertIcon,
	'The hery CLI': terminalIcon,
	'The blueprint contract': fileTextIcon,
	'What gets generated': fileCodeIcon,
	'Testing conventions': flaskIcon,
	'The module system': puzzleIcon,
	'Full-text search': searchIcon,
	Realtime: radioIcon,
	'Mail and storage': mailIcon,
	Impersonation: userCogIcon,
	'GraphQL and MCP': shareIcon,
	'Admin panel and introspection': layoutDashboardIcon,
	Overview: bookOpenIcon,
	Search: searchIcon,
	Details: fileSearchIcon,
	'Create and update': pencilIcon,
	'Delete and restore': trashIcon,
	'Developer tooling': wrenchIcon,
	'Pipeline trace': activityIcon,
};

// Starlight's own flattenSidebar lives under utils/, a path its package.json
// "exports" map doesn't expose -- reimplemented rather than reached for with
// a deep import Node would refuse to resolve.
function flattenSidebar(entries: any[]): any[] {
	return entries.flatMap((entry) => (entry.type === 'group' ? flattenSidebar(entry.entries) : entry));
}

interface Props {
	sublist: any[];
	nested?: boolean;
}

const { sublist, nested } = Astro.props as Props;
---

<ul class:list={{ 'top-level': !nested }}>
	{
		sublist.map((entry: any) => (
			<li>
				{entry.type === 'link' ? (
					<a
						href={entry.href}
						aria-current={entry.isCurrent ? 'page' : undefined}
						class:list={[{ large: !nested }, entry.attrs.class]}
						{...entry.attrs}
					>
						{LEAF_ICONS[entry.label] && <span class="nav-icon" set:html={LEAF_ICONS[entry.label]} />}
						<span>{entry.label}</span>
					</a>
				) : (
					<details open={flattenSidebar(entry.entries).some((i: any) => i.isCurrent) || !entry.collapsed}>
						<summary>
							<span class="group-label">
								{!nested && TOP_LEVEL_ICONS[entry.label] && (
									<span class="nav-icon" set:html={TOP_LEVEL_ICONS[entry.label]} />
								)}
								<span class="large">{entry.label}</span>
							</span>
							<span class="caret" set:html={caretIcon} />
						</summary>
						<SidebarRestorePoint />
						<Astro.self sublist={entry.entries} nested />
					</details>
				)}
			</li>
		))
	}
</ul>

<style>
	@layer starlight.core {
		ul {
			--sl-sidebar-item-padding-inline: 0.5rem;
			list-style: none;
			padding: 0;
		}

		li {
			overflow-wrap: anywhere;
		}

		ul ul li {
			margin-inline-start: var(--sl-sidebar-item-padding-inline);
			border-inline-start: 1px solid var(--sl-color-hairline-light);
			padding-inline-start: var(--sl-sidebar-item-padding-inline);
		}

		.large {
			font-size: var(--sl-text-lg);
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.top-level > li + li {
			margin-top: 0.75rem;
		}

		.group-label {
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}

		.nav-icon {
			display: inline-flex;
			flex-shrink: 0;
			color: var(--sl-color-accent);
		}

		.nav-icon :global(svg) {
			width: 1.1rem;
			height: 1.1rem;
		}

		summary {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0.2em var(--sl-sidebar-item-padding-inline);
			line-height: 1.4;
			cursor: pointer;
			user-select: none;
		}
		summary::marker,
		summary::-webkit-details-marker {
			display: none;
		}

		.caret {
			display: inline-flex;
			flex-shrink: 0;
			transition: transform 0.2s ease-in-out;
			color: var(--sl-color-gray-3);
		}
		.caret :global(svg) {
			width: 1rem;
			height: 1rem;
		}
		:global([dir='rtl']) .caret {
			transform: rotateZ(180deg);
		}
		[open] > summary .caret {
			transform: rotateZ(90deg);
		}

		a {
			display: block;
			border-radius: 0.25rem;
			text-decoration: none;
			color: var(--sl-color-gray-2);
			padding: 0.3em var(--sl-sidebar-item-padding-inline);
			line-height: 1.4;
		}

		a:hover,
		a:focus {
			color: var(--sl-color-white);
		}

		[aria-current='page'],
		[aria-current='page']:hover,
		[aria-current='page']:focus {
			font-weight: 600;
			color: var(--sl-color-text-invert);
			background-color: var(--sl-color-text-accent);
		}

		a > *:not(:last-child),
		.group-label > *:not(:last-child) {
			margin-inline-end: 0.25em;
		}

		@media (min-width: 50rem) {
			.top-level > li + li {
				margin-top: 0.5rem;
			}
			.large {
				font-size: var(--sl-text-base);
			}
			a {
				font-size: var(--sl-text-sm);
			}
		}
	}
</style>
