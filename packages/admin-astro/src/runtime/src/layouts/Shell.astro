---
import '../styles/admin.css';

interface Props {
  title: string;
  bare?: boolean;
}

const { title, bare = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — HeryJs admin</title>
  </head>
  <body>
    {
      bare ? (
        <div class="centered">
          <slot />
        </div>
      ) : (
        <div class="shell">
          <aside class="side">
            <a class="brand" href="/">
              <span class="mark" id="brand-mark" />
              <span>
                <strong>HeryJs</strong>
                <span>Admin</span>
              </span>
            </a>

            <nav class="group">
              <h2>General</h2>
              <a class="item" href="/" id="overview-link" />
              <a class="item" href="/pipeline" id="pipeline-link" />
              <a class="item" href="/devtools" id="devtools-link" />
              <a class="item" href="/http-circuits" id="circuits-link" />
              <a class="item" href="/prune" id="prune-link" />
              <a class="item" href="/quotas" id="quotas-link" />
              <a class="item" href="/backups" id="backups-link" />
            </nav>

            <nav class="group scrolls" id="sections" aria-label="Sections" />

            <footer>
              <code id="api-url" />
              <button class="item" id="sign-out" type="button" />
            </footer>
          </aside>

          <main>
            <header class="top">
              <span>HeryJs</span>
              <span id="crumb-icon" />
              <span class="crumb" id="crumb">
                {title}
              </span>
              <span class="spacer" />
              <span id="top-extra" />
            </header>

            <div class="page">
              <slot />
            </div>
          </main>
        </div>
      )
    }

    <script>
      import { API_URL, groupedSections, sectionsOf } from '../lib/api';
      import { loadControllers } from '../lib/introspection';
      import { resourcesOf } from '../lib/resource';
      import { ICONS, adminIcon, icon, tintOf } from '../lib/icons';
      import { clearToken, token } from '../lib/session';

      const onLogin = window.location.pathname.startsWith('/login');

      if (!token() && !onLogin) {
        window.location.href = '/login';
      }

      const label = (
        element: HTMLElement | null,
        node: typeof ICONS.overview,
        text: string,
      ) => {
        if (!element) {
          return;
        }

        const caption = document.createElement('span');
        caption.textContent = text;
        element.append(icon(node), caption);
      };

      document.getElementById('brand-mark')?.appendChild(icon(ICONS.brand, 16));
      document.getElementById('crumb-icon')?.appendChild(icon(ICONS.crumb, 13));
      label(
        document.getElementById('overview-link'),
        ICONS.overview,
        'Overview',
      );
      label(
        document.getElementById('pipeline-link'),
        ICONS.pipeline,
        'Pipeline',
      );
      label(
        document.getElementById('devtools-link'),
        ICONS.devtools,
        'Dev dashboard',
      );
      label(
        document.getElementById('circuits-link'),
        ICONS.circuits,
        'HTTP circuits',
      );
      label(document.getElementById('prune-link'), ICONS.prune, 'Prune');
      label(document.getElementById('quotas-link'), ICONS.quotas, 'Quotas');
      label(document.getElementById('backups-link'), ICONS.backups, 'Backups');
      label(document.getElementById('sign-out'), ICONS.signOut, 'Sign out');

      const apiUrl = document.getElementById('api-url');

      if (apiUrl) {
        apiUrl.textContent = API_URL.replace(/^https?:\/\//, '');
        apiUrl.title = API_URL;
      }

      document.getElementById('sign-out')?.addEventListener('click', () => {
        clearToken();
        window.location.href = '/login';
      });

      if (token() && !onLogin) {
        const nav = document.getElementById('sections');
        const data = await loadControllers().catch(() => []);
        const query = new URLSearchParams(window.location.search);
        const current = query.get('path') ?? query.get('base');
        const bases = resourcesOf(data).map((resource) => resource.base);

        for (const { group, sections } of groupedSections(sectionsOf(data))) {
          const heading = document.createElement('h2');
          heading.textContent = group;
          nav?.appendChild(heading);

          for (const section of sections) {
            const link = document.createElement('a');
            link.className = 'item ' + tintOf(section.path);
            const base =
              section.method === 'POST'
                ? section.path.slice(0, -'/search'.length)
                : section.path;
            const isResource =
              section.method === 'POST' && bases.includes(base);
            link.href = isResource
              ? '/resource?base=' + encodeURIComponent(base)
              : '/browse?path=' +
                encodeURIComponent(section.path) +
                '&method=' +
                section.method;
            label(link, adminIcon(section.icon, section.path), section.label);

            if (section.path === current || base === current) {
              link.setAttribute('aria-current', 'page');
            }

            nav?.appendChild(link);
          }
        }
      }
    </script>
  </body>
</html>
