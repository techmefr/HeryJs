{
  "name": "@heryjs/webhooks",
  "version": "0.1.0",
  "description": "Receive inbound webhooks with HMAC-SHA256 signature verification (constant-time, timestamp-tolerant against replay) and run each accepted payload through Event, Job, Notification, Audit and Signal, and deliver signed outbound webhooks to your tenants' own URLs with retry, a dead-letter state and secret rotation.",
  "author": "Gaetan Compigni",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://techmefr.github.io/HeryJs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techmefr/HeryJs.git",
    "directory": "packages/webhooks"
  },
  "bugs": {
    "url": "https://github.com/techmefr/HeryJs/issues"
  },
  "keywords": [
    "heryjs",
    "heryjs-module",
    "nestjs"
  ],
  "heryjs": {
    "module": true
  },
  "main": "dist/module.js",
  "types": "dist/module.d.ts",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "default": "./dist/module.js"
    },
    "./hery": {
      "heryjs-source": "./src/runtime/webhooks.hery.ts",
      "types": "./dist/runtime/webhooks.hery.d.ts",
      "default": "./dist/runtime/webhooks.hery.js"
    },
    "./*": {
      "heryjs-source": "./src/runtime/*.ts",
      "types": "./dist/runtime/*.d.ts",
      "default": "./dist/runtime/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/runtime"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm --filter heryjs run build:scaffold && pnpm run build"
  },
  "peerDependencies": {
    "@heryjs/core": "workspace:^",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/schedule": "^12.0.0",
    "@prisma/client": "^7.0.0",
    "bullmq": "^6.0.0",
    "express": "^5.0.0",
    "heryjs": "workspace:^",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@heryjs/core": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@types/express": "^5.0.0",
    "bullmq": "^6.3.4",
    "heryjs": "workspace:*",
    "picocolors": "^1.1.1",
    "typescript": "^6.0.3",
    "zod": "^4.5.4"
  }
}
