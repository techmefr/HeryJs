{
  "name": "@heryjs/two-factor",
  "version": "0.1.0",
  "description": "Time-based one-time passwords for HeryJs: enrolment confirmed by a first code, a second-factor check on the session, hashed single-use recovery codes, and a per-role requirement",
  "author": "Gaetan Compigni",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://techmefr.github.io/HeryJs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techmefr/HeryJs.git",
    "directory": "packages/two-factor"
  },
  "bugs": {
    "url": "https://github.com/techmefr/HeryJs/issues"
  },
  "keywords": [
    "heryjs",
    "heryjs-module",
    "nestjs"
  ],
  "heryjs": {
    "module": true
  },
  "main": "dist/module.js",
  "types": "dist/module.d.ts",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "default": "./dist/module.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/runtime"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm --filter heryjs run build:scaffold && pnpm run build"
  },
  "peerDependencies": {
    "@heryjs/core": "workspace:^",
    "@nestjs/common": "^12.0.0",
    "express": "^5.0.0",
    "heryjs": "workspace:^",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@heryjs/core": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "heryjs": "workspace:*",
    "picocolors": "^1.1.1",
    "typescript": "^6.0.3"
  }
}
