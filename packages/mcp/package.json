{
  "name": "@heryjs/mcp",
  "version": "0.1.0",
  "description": "Add an authenticated MCP gateway (Streamable HTTP, stateless) exposing generated resources as tools. Use \"hery generate <Name> --mcp\" to add write tools to a resource.",
  "author": "Gaetan Compigni",
  "license": "MIT",
  "homepage": "https://techmefr.github.io/HeryJs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techmefr/HeryJs.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/techmefr/HeryJs/issues"
  },
  "keywords": [
    "heryjs",
    "heryjs-module",
    "nestjs"
  ],
  "heryjs": {
    "module": true
  },
  "main": "dist/module.js",
  "types": "dist/module.d.ts",
  "files": [
    "dist",
    "src/runtime"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm --filter heryjs run build:scaffold && pnpm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@types/express": "^5.0.0",
    "express": "^5.0.1",
    "heryjs": "workspace:*",
    "picocolors": "^1.1.1",
    "reflect-metadata": "^0.2.2",
    "typescript": "^6.0.3"
  }
}
