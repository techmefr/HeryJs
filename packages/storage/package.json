{
  "name": "@heryjs/storage",
  "version": "1.0.0",
  "description": "Add file storage behind a swappable provider: local disk (signed local URLs) by default, S3-compatible (real S3 or self-hosted MinIO) via STORAGE_DRIVER=s3.",
  "author": "Gaetan Compigni",
  "license": "MIT",
  "type": "commonjs",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://techmefr.github.io/HeryJs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techmefr/HeryJs.git",
    "directory": "packages/storage"
  },
  "bugs": {
    "url": "https://github.com/techmefr/HeryJs/issues"
  },
  "keywords": [
    "heryjs",
    "heryjs-module",
    "nestjs"
  ],
  "engines": {
    "node": ">=24.20"
  },
  "heryjs": {
    "module": true
  },
  "main": "dist/module.js",
  "types": "dist/module.d.ts",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "default": "./dist/module.js"
    },
    "./hery": {
      "heryjs-source": "./src/runtime/storage.hery.ts",
      "types": "./dist/runtime/storage.hery.d.ts",
      "default": "./dist/runtime/storage.hery.js"
    },
    "./*": {
      "heryjs-source": "./src/runtime/*.ts",
      "types": "./dist/runtime/*.d.ts",
      "default": "./dist/runtime/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/runtime",
    "docker-compose.storage.yml"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm --filter heryjs run build:scaffold && pnpm run build"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@heryjs/core": "workspace:*",
    "@nestjs/common": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "express": "^5.0.0",
    "heryjs": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@heryjs/core": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@types/express": "^5.0.0",
    "heryjs": "workspace:*",
    "picocolors": "^1.1.1",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "heryjs": {
      "optional": true
    }
  }
}
