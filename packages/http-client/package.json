{
  "name": "@heryjs/http-client",
  "version": "1.0.0",
  "description": "Call other people's APIs behind one contract: a retrying ofetch driver, and a fake driver that records every request and refuses to reach the network in tests.",
  "author": "Gaetan Compigni",
  "license": "MIT",
  "type": "commonjs",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://techmefr.github.io/HeryJs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techmefr/HeryJs.git",
    "directory": "packages/http-client"
  },
  "bugs": {
    "url": "https://github.com/techmefr/HeryJs/issues"
  },
  "keywords": [
    "heryjs",
    "heryjs-module",
    "nestjs"
  ],
  "engines": {
    "node": ">=24.20"
  },
  "heryjs": {
    "module": true
  },
  "main": "dist/module.js",
  "types": "dist/module.d.ts",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "default": "./dist/module.js"
    },
    "./hery": {
      "heryjs-source": "./src/runtime/http-client.hery.ts",
      "types": "./dist/runtime/http-client.hery.d.ts",
      "default": "./dist/runtime/http-client.hery.js"
    },
    "./*": {
      "heryjs-source": "./src/runtime/*.ts",
      "types": "./dist/runtime/*.d.ts",
      "default": "./dist/runtime/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/runtime"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm --filter heryjs run build:scaffold && pnpm run build"
  },
  "peerDependencies": {
    "@heryjs/core": "workspace:*",
    "@nestjs/common": "^12.0.0",
    "@prometheus-io/client": "^0.16.0",
    "heryjs": "workspace:*",
    "ofetch": "^1.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@heryjs/core": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "heryjs": "workspace:*",
    "ofetch": "^1.4.1",
    "picocolors": "^1.1.1",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "heryjs": {
      "optional": true
    }
  }
}
