{
  "name": "@heryjs/observe",
  "version": "1.0.0",
  "description": "Optional APM through @nestjs/observe, off by default, sending nothing to a third party until you turn it on and point it somewhere",
  "author": "Gaetan Compigni",
  "license": "MIT",
  "type": "commonjs",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://techmefr.github.io/HeryJs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techmefr/HeryJs.git",
    "directory": "packages/observe"
  },
  "bugs": {
    "url": "https://github.com/techmefr/HeryJs/issues"
  },
  "keywords": [
    "heryjs",
    "heryjs-module",
    "nestjs"
  ],
  "engines": {
    "node": ">=24.20"
  },
  "heryjs": {
    "module": true
  },
  "main": "dist/module.js",
  "types": "dist/module.d.ts",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "default": "./dist/module.js"
    },
    "./hery": {
      "heryjs-source": "./src/runtime/observe.hery.ts",
      "types": "./dist/runtime/observe.hery.d.ts",
      "default": "./dist/runtime/observe.hery.js"
    },
    "./*": {
      "heryjs-source": "./src/runtime/*.ts",
      "types": "./dist/runtime/*.d.ts",
      "default": "./dist/runtime/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/runtime"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm --filter heryjs run build:scaffold && pnpm run build"
  },
  "peerDependencies": {
    "@heryjs/core": "workspace:*",
    "@nestjs/common": "^12.0.0",
    "@nestjs/observe": "^0.3.18",
    "heryjs": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@heryjs/core": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/observe": "^0.3.18",
    "heryjs": "workspace:*",
    "picocolors": "^1.1.1",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "heryjs": {
      "optional": true
    }
  }
}
