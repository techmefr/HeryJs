{
  "name": "@heryjs/search-elasticsearch",
  "version": "0.1.0",
  "description": "Swap free-text search from Prisma contains() to Elasticsearch (docker service, driver, DI wiring)",
  "author": "Gaetan Compigni",
  "license": "MIT",
  "type": "commonjs",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://techmefr.github.io/HeryJs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techmefr/HeryJs.git",
    "directory": "packages/search-elasticsearch"
  },
  "bugs": {
    "url": "https://github.com/techmefr/HeryJs/issues"
  },
  "keywords": [
    "heryjs",
    "heryjs-module",
    "nestjs"
  ],
  "heryjs": {
    "module": true
  },
  "main": "dist/module.js",
  "types": "dist/module.d.ts",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "default": "./dist/module.js"
    },
    "./hery": {
      "heryjs-source": "./src/runtime/search-elasticsearch.hery.ts",
      "types": "./dist/runtime/search-elasticsearch.hery.d.ts",
      "default": "./dist/runtime/search-elasticsearch.hery.js"
    },
    "./*": {
      "heryjs-source": "./src/runtime/*.ts",
      "types": "./dist/runtime/*.d.ts",
      "default": "./dist/runtime/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/runtime",
    "docker-compose.search-elasticsearch.yml"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm --filter heryjs run build:scaffold && pnpm run build"
  },
  "peerDependencies": {
    "@elastic/elasticsearch": "^9.0.0",
    "@heryjs/core": "workspace:*",
    "@nestjs/common": "^12.0.0",
    "heryjs": "workspace:*"
  },
  "devDependencies": {
    "@elastic/elasticsearch": "^9.5.1",
    "@heryjs/core": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "heryjs": "workspace:*",
    "picocolors": "^1.1.1",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "heryjs": {
      "optional": true
    }
  }
}
