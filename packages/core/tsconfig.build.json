{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../../src",
    "outDir": "dist",
    "paths": {
      "#technical/*": ["../../src/technical/*"],
      "#devtools/*": ["../../src/devtools/*"]
    },
    "declaration": true,
    "sourceMap": false,
    "incremental": false,
    "removeComments": false,
    "noEmit": false,
    "types": ["node"]
  },
  "include": ["../../src/technical/**/*.ts", "../../src/devtools/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "../../src/technical/**/*.spec.ts",
    "../../src/technical/**/*.e2e-spec.ts",
    "../../src/devtools/**/*.spec.ts",
    "../../src/devtools/testing",
    "../../src/devtools/test-support.ts"
  ]
}
