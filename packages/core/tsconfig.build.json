{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../../src/technical",
    "outDir": "dist",
    "paths": {
      "#technical/*": ["../../src/technical/*"]
    },
    "declaration": true,
    "sourceMap": false,
    "incremental": false,
    "removeComments": false,
    "noEmit": false,
    "types": ["node"]
  },
  "include": ["../../src/technical/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "../../src/technical/**/*.spec.ts",
    "../../src/technical/**/*.e2e-spec.ts"
  ]
}
