{
  "name": "@heryjs/core",
  "version": "1.0.0",
  "description": "The HeryJs kernel: auth, RBAC, Postgres row-level security, jobs, real time and the rest of src/technical, as the public entries modules import.",
  "author": "Gaetan Compigni",
  "license": "MIT",
  "type": "commonjs",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://techmefr.github.io/HeryJs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techmefr/HeryJs.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/techmefr/HeryJs/issues"
  },
  "keywords": [
    "heryjs",
    "nestjs"
  ],
  "engines": {
    "node": ">=24.20"
  },
  "sideEffects": [
    "./dist/technical/monitoring/metrics.registry.js"
  ],
  "exports": {
    "./auth": {
      "heryjs-source": "./src/technical/public/auth.ts",
      "types": "./dist/technical/public/auth.d.ts",
      "default": "./dist/technical/public/auth.js"
    },
    "./capabilities": {
      "heryjs-source": "./src/technical/public/capabilities.ts",
      "types": "./dist/technical/public/capabilities.d.ts",
      "default": "./dist/technical/public/capabilities.js"
    },
    "./config": {
      "heryjs-source": "./src/technical/public/config.ts",
      "types": "./dist/technical/public/config.d.ts",
      "default": "./dist/technical/public/config.js"
    },
    "./database": {
      "heryjs-source": "./src/technical/public/database.ts",
      "types": "./dist/technical/public/database.d.ts",
      "default": "./dist/technical/public/database.js"
    },
    "./drivers": {
      "heryjs-source": "./src/technical/public/drivers.ts",
      "types": "./dist/technical/public/drivers.d.ts",
      "default": "./dist/technical/public/drivers.js"
    },
    "./env": {
      "heryjs-source": "./src/technical/public/env.ts",
      "types": "./dist/technical/public/env.d.ts",
      "default": "./dist/technical/public/env.js"
    },
    "./errors": {
      "heryjs-source": "./src/technical/public/errors.ts",
      "types": "./dist/technical/public/errors.d.ts",
      "default": "./dist/technical/public/errors.js"
    },
    "./http": {
      "heryjs-source": "./src/technical/public/http.ts",
      "types": "./dist/technical/public/http.d.ts",
      "default": "./dist/technical/public/http.js"
    },
    "./i18n": {
      "heryjs-source": "./src/technical/public/i18n.ts",
      "types": "./dist/technical/public/i18n.d.ts",
      "default": "./dist/technical/public/i18n.js"
    },
    "./jobs": {
      "heryjs-source": "./src/technical/public/jobs.ts",
      "types": "./dist/technical/public/jobs.d.ts",
      "default": "./dist/technical/public/jobs.js"
    },
    "./load-env": {
      "heryjs-source": "./src/technical/public/load-env.ts",
      "types": "./dist/technical/public/load-env.d.ts",
      "default": "./dist/technical/public/load-env.js"
    },
    "./modules": {
      "heryjs-source": "./src/technical/public/modules.ts",
      "types": "./dist/technical/public/modules.d.ts",
      "default": "./dist/technical/public/modules.js"
    },
    "./notifications": {
      "heryjs-source": "./src/technical/public/notifications.ts",
      "types": "./dist/technical/public/notifications.d.ts",
      "default": "./dist/technical/public/notifications.js"
    },
    "./observability": {
      "heryjs-source": "./src/technical/public/observability.ts",
      "types": "./dist/technical/public/observability.d.ts",
      "default": "./dist/technical/public/observability.js"
    },
    "./platform": {
      "heryjs-source": "./src/technical/public/platform.ts",
      "types": "./dist/technical/public/platform.d.ts",
      "default": "./dist/technical/public/platform.js"
    },
    "./privacy": {
      "heryjs-source": "./src/technical/public/privacy.ts",
      "types": "./dist/technical/public/privacy.d.ts",
      "default": "./dist/technical/public/privacy.js"
    },
    "./realtime": {
      "heryjs-source": "./src/technical/public/realtime.ts",
      "types": "./dist/technical/public/realtime.d.ts",
      "default": "./dist/technical/public/realtime.js"
    },
    "./resources": {
      "heryjs-source": "./src/technical/public/resources.ts",
      "types": "./dist/technical/public/resources.d.ts",
      "default": "./dist/technical/public/resources.js"
    },
    "./tenancy": {
      "heryjs-source": "./src/technical/public/tenancy.ts",
      "types": "./dist/technical/public/tenancy.d.ts",
      "default": "./dist/technical/public/tenancy.js"
    },
    "./testing": {
      "heryjs-source": "./src/technical/public/testing.ts",
      "types": "./dist/technical/public/testing.d.ts",
      "default": "./dist/technical/public/testing.js"
    },
    "./devtools": {
      "heryjs-source": "./src/devtools/public.ts",
      "types": "./dist/devtools/public.d.ts",
      "default": "./dist/devtools/public.js"
    },
    "./conventions": {
      "heryjs-source": "./src/devtools/conventions/index.ts",
      "types": "./dist/devtools/conventions/index.d.ts",
      "default": "./dist/devtools/conventions/index.js"
    },
    "./app": {
      "heryjs-source": "./src/hery/public.ts",
      "types": "./dist/hery/public.d.ts",
      "default": "./dist/hery/public.js"
    },
    "./technical/*": {
      "heryjs-source": "./src/technical/*.ts",
      "types": "./dist/technical/*.d.ts",
      "default": "./dist/technical/*.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#technical/*": {
      "types": "./dist/technical/*.d.ts",
      "default": "./dist/technical/*.js"
    },
    "#devtools/*": {
      "types": "./dist/devtools/*.d.ts",
      "default": "./dist/devtools/*.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@better-auth/passkey": "1.7.14",
    "@bull-board/api": "^9.8.0",
    "@bull-board/express": "^9.8.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prometheus-io/client": "^0.16.1",
    "better-auth": "^1.7.3",
    "bullmq": "^6.3.4",
    "cron": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.1.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rxjs": "^7.8.1",
    "sanitize-html": "2.18.1",
    "socket.io": "^4.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "pino-pretty": {
      "optional": true
    },
    "ts-node": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
