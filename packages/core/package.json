{
  "name": "@heryjs/core",
  "version": "0.1.0",
  "private": true,
  "description": "The HeryJs kernel: auth, RBAC, Postgres row-level security, jobs, real time and the rest of src/technical, as the public entries modules import.",
  "author": "Gaetan Compigni",
  "license": "MIT",
  "homepage": "https://techmefr.github.io/HeryJs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techmefr/HeryJs.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/techmefr/HeryJs/issues"
  },
  "keywords": [
    "heryjs",
    "nestjs"
  ],
  "engines": {
    "node": ">=24.20"
  },
  "sideEffects": [
    "./dist/monitoring/metrics.registry.js"
  ],
  "exports": {
    "./auth": {
      "types": "./dist/public/auth.d.ts",
      "default": "./dist/public/auth.js"
    },
    "./capabilities": {
      "types": "./dist/public/capabilities.d.ts",
      "default": "./dist/public/capabilities.js"
    },
    "./config": {
      "types": "./dist/public/config.d.ts",
      "default": "./dist/public/config.js"
    },
    "./database": {
      "types": "./dist/public/database.d.ts",
      "default": "./dist/public/database.js"
    },
    "./drivers": {
      "types": "./dist/public/drivers.d.ts",
      "default": "./dist/public/drivers.js"
    },
    "./env": {
      "types": "./dist/public/env.d.ts",
      "default": "./dist/public/env.js"
    },
    "./errors": {
      "types": "./dist/public/errors.d.ts",
      "default": "./dist/public/errors.js"
    },
    "./http": {
      "types": "./dist/public/http.d.ts",
      "default": "./dist/public/http.js"
    },
    "./i18n": {
      "types": "./dist/public/i18n.d.ts",
      "default": "./dist/public/i18n.js"
    },
    "./jobs": {
      "types": "./dist/public/jobs.d.ts",
      "default": "./dist/public/jobs.js"
    },
    "./notifications": {
      "types": "./dist/public/notifications.d.ts",
      "default": "./dist/public/notifications.js"
    },
    "./observability": {
      "types": "./dist/public/observability.d.ts",
      "default": "./dist/public/observability.js"
    },
    "./platform": {
      "types": "./dist/public/platform.d.ts",
      "default": "./dist/public/platform.js"
    },
    "./privacy": {
      "types": "./dist/public/privacy.d.ts",
      "default": "./dist/public/privacy.js"
    },
    "./realtime": {
      "types": "./dist/public/realtime.d.ts",
      "default": "./dist/public/realtime.js"
    },
    "./tenancy": {
      "types": "./dist/public/tenancy.d.ts",
      "default": "./dist/public/tenancy.js"
    },
    "./testing": {
      "types": "./dist/public/testing.d.ts",
      "default": "./dist/public/testing.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#technical/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@better-auth/passkey": "1.7.3",
    "@bull-board/api": "^9.8.0",
    "@bull-board/express": "^9.8.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prometheus-io/client": "^0.16.1",
    "better-auth": "^1.7.3",
    "bullmq": "^6.3.4",
    "cron": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rxjs": "^7.8.1",
    "sanitize-html": "2.18.1",
    "socket.io": "^4.8.3",
    "ts-node": "^10.9.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
