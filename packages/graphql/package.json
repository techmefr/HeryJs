{
  "name": "@heryjs/graphql",
  "version": "0.1.0",
  "description": "Add a GraphQL endpoint (Apollo driver) with a session guard mirroring the REST auth flow. Use \"hery generate <Name> --graphql\" to add a resolver to a resource.",
  "author": "Gaetan Compigni",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://techmefr.github.io/HeryJs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techmefr/HeryJs.git",
    "directory": "packages/graphql"
  },
  "bugs": {
    "url": "https://github.com/techmefr/HeryJs/issues"
  },
  "keywords": [
    "heryjs",
    "heryjs-module",
    "nestjs"
  ],
  "heryjs": {
    "module": true
  },
  "main": "dist/module.js",
  "types": "dist/module.d.ts",
  "files": [
    "dist",
    "src/runtime"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm --filter heryjs run build:scaffold && pnpm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0"
  },
  "devDependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "express": "^5.0.1",
    "graphql": "^16.11.0",
    "heryjs": "workspace:*",
    "picocolors": "^1.1.1",
    "reflect-metadata": "^0.2.2",
    "typescript": "^6.0.3"
  }
}
