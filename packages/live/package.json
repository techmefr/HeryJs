{
  "name": "@heryjs/live",
  "version": "1.0.0",
  "description": "Add bidirectional WebSocket support (Socket.IO). Use \"hery generate <Name> --live\" to add a live gateway to a resource.",
  "author": "Gaetan Compigni",
  "license": "MIT",
  "type": "commonjs",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://techmefr.github.io/HeryJs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techmefr/HeryJs.git",
    "directory": "packages/live"
  },
  "bugs": {
    "url": "https://github.com/techmefr/HeryJs/issues"
  },
  "keywords": [
    "heryjs",
    "heryjs-module",
    "nestjs"
  ],
  "engines": {
    "node": ">=24.20"
  },
  "heryjs": {
    "module": true
  },
  "main": "dist/module.js",
  "types": "dist/module.d.ts",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "default": "./dist/module.js"
    },
    "./hery": {
      "heryjs-source": "./src/runtime/live.hery.ts",
      "types": "./dist/runtime/live.hery.d.ts",
      "default": "./dist/runtime/live.hery.js"
    },
    "./*": {
      "heryjs-source": "./src/runtime/*.ts",
      "types": "./dist/runtime/*.d.ts",
      "default": "./dist/runtime/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/runtime"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm --filter heryjs run build:scaffold && pnpm run build"
  },
  "peerDependencies": {
    "@heryjs/core": "workspace:*",
    "@nestjs/common": "^12.0.0",
    "@nestjs/websockets": "^12.0.0",
    "heryjs": "workspace:*"
  },
  "devDependencies": {
    "@heryjs/core": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.0.1",
    "@nestjs/websockets": "^12.0.1",
    "heryjs": "workspace:*",
    "picocolors": "^1.1.1",
    "socket.io": "^4.8.1",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "heryjs": {
      "optional": true
    }
  }
}
