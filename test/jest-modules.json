{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/packages"],
  "testEnvironment": "node",
  "testRegex": ".integration-spec.ts$",
  "globalSetup": "<rootDir>/test/global-setup.ts",
  "moduleNameMapper": {
    "^@heryjs/core/devtools$": "<rootDir>/src/devtools/public",
    "^@heryjs/core/(.*)$": "<rootDir>/src/technical/public/$1",
    "^#kernel/(.*)$": "<rootDir>/src/technical/$1",
    "^#technical/(.*)$": "<rootDir>/src/technical/$1",
    "^#devtools/(.*)$": "<rootDir>/src/devtools/$1",
    "^#modules/(.*)$": "<rootDir>/src/modules/$1",
    "^#functional/(.*)$": "<rootDir>/src/functional/$1"
  },
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "test/tsconfig.modules.json"
      }
    ]
  },
  "testTimeout": 60000,
  "forceExit": true
}
