{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/packages"],
  "testEnvironment": "node",
  "testRegex": ".integration-spec.ts$",
  "moduleNameMapper": {
    "^#kernel/(.*)$": "<rootDir>/src/technical/$1"
  },
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "test/tsconfig.modules.json" }]
  },
  "testTimeout": 60000,
  "forceExit": true
}
