{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/packages"],
  "testEnvironment": "node",
  "testRegex": "src/runtime/.*\\.spec\\.ts$",
  "testPathIgnorePatterns": ["/node_modules/", "packages/admin-astro/"],
  "globalSetup": "<rootDir>/test/global-setup.ts",
  "moduleNameMapper": {
    "^#kernel/(.*)$": "<rootDir>/src/technical/$1",
    "^#technical/(.*)$": "<rootDir>/src/technical/$1",
    "^#devtools/(.*)$": "<rootDir>/src/devtools/$1",
    "^#modules/(.*)$": "<rootDir>/src/modules/$1",
    "^#functional/(.*)$": "<rootDir>/src/functional/$1"
  },
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "test/tsconfig.modules.json" }]
  },
  "testTimeout": 15000,
  "forceExit": true
}
