# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# DATABASE_URL and REDIS_URL below use the compose defaults; run
# "pnpm hery up --start" to boot docker compose and rewrite these two lines
# with whatever host ports Docker actually assigned (kept free of collisions
# so several checkouts/worktrees can run at once).
DATABASE_URL="postgresql://heryjs:heryjs@localhost:5432/heryjs"
BETTER_AUTH_URL="http://localhost:3000"
REDIS_URL="redis://localhost:6379"

# Optional overrides for "pnpm hery hosts" and the Caddy reverse proxy, useful
# when running more than one HeryJs checkout at the same time.
# HERYJS_DOMAIN="heryjs.local"
# HERYJS_APP_PORT="3000"
# HERYJS_HTTP_PORT="80"
# HERYJS_HTTPS_PORT="443"
