# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The database URLs and REDIS_URL below use the compose defaults; run
# "pnpm hery up --start" to boot docker compose and rewrite these lines
# with whatever host ports Docker actually assigned (kept free of collisions
# so several checkouts/worktrees can run at once).
# Only a NODE_ENV listed in devTools.environments (hery.config.ts) opens the
# devtools routes and accepts the development secrets; unset, the app runs as
# production.
NODE_ENV=development

# DATABASE_URL is the app's role: no superuser, no BYPASSRLS, so Postgres
# row-level security applies to every query it runs. DATABASE_MIGRATION_URL is
# the schema owner, used by prisma migrate, seeds' DDL and backups only.
DATABASE_URL="postgresql://heryjs_app:heryjs_app@localhost:5432/heryjs"
DATABASE_MIGRATION_URL="postgresql://heryjs:heryjs@localhost:5432/heryjs"
BETTER_AUTH_URL="http://localhost:3000"
REDIS_URL="redis://localhost:6479"

# The origins allowed to call this API from a browser, comma-separated. Set, it
# replaces the list in cors.config.ts; empty, it turns CORS off. "*" is refused
# under NODE_ENV=production, which is where this has to be set.
# CORS_ORIGINS="https://app.example.com,https://admin.example.com"

# How many full-text matches an engine is asked for before the result set is
# cut. Each engine ships a different default -- 10 for Elasticsearch, 20 for
# Meilisearch, none at all for the built-in Prisma driver -- so the limit is
# declared here instead, applied by every driver, and reported in a search
# response's meta.search once it is reached.
# SEARCH_MATCH_LIMIT="1000"

# The outbox relay delivers staged model changes and events. It runs inside
# every process by default; set OUTBOX_RELAY_ENABLED="false" on web processes
# when dedicated workers should own it. The interval is how often a pass runs.
# OUTBOX_RELAY_ENABLED="true"
# OUTBOX_RELAY_INTERVAL_MS="2000"
# Audit streaming: the task that hands new audit entries to each sink's outbox
# delivery. A sink URL resolving to a private address is refused unless allowed.
# AUDIT_STREAM_ENABLED="true"
# AUDIT_STREAM_INTERVAL_SECONDS="10"
# AUDIT_SINK_ALLOW_PRIVATE_HOSTS="false"
# A scheduled pg_dump (default daily at 03:00; editable from the admin panel) kept in BACKUP_DIR, newest BACKUP_KEEP only.
# Needs pg_dump on the machine running the app. BACKUP_STORAGE_DRIVER also
# uploads each dump through the installed storage driver of that name.
# BACKUP_ENABLED="false"
# BACKUP_CRON="0 3 * * *"
# BACKUP_DIR="backups"
# BACKUP_KEEP="7"
# BACKUP_STORAGE_DRIVER="local"
# Completed erasures, by id only, replayed after every restore so a dump taken
# before an erasure does not bring the person back. Keep it outside the dumps.
# PRIVACY_ERASURE_JOURNAL="privacy/erasures.jsonl"
# Traces, metrics and logs leave over OTLP only when this is set. Everything
# else (headers, protocol, sampler) is the standard OTEL_* configuration.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# OTEL_SERVICE_NAME="heryjs"

# Most rows a similarity search (search.mode: "similar") ranks and returns.
# Nearest-neighbour search never runs out of matches, so it is capped.
# VECTOR_SEARCH_LIMIT="50"

# Embeddings module: the width of the vector fields in your blueprints, and
# the openai-compatible driver's endpoint (OpenAI, Ollama, vLLM, LiteLLM).
# EMBEDDINGS_DIMENSIONS="1536"
# EMBEDDINGS_OPENAI_BASE_URL="https://api.openai.com/v1"
# EMBEDDINGS_OPENAI_API_KEY=""
# EMBEDDINGS_OPENAI_MODEL="text-embedding-3-small"

# Left unset, these two fall back to development defaults and the app boots.
# With NODE_ENV=production it refuses to boot until both are real secrets: a
# default printed in a public repository is not a secret. They are separate so
# that a leak on either side does not forge the other.
# SIGNAL_TOKEN_SECRET="openssl rand -base64 32"
# SSE_TOKEN_SECRET="openssl rand -base64 32"
# OAUTH_STATE_SECRET="openssl rand -base64 32"
# SSO_STATE_SECRET="openssl rand -base64 32"
# SSO_SECRET_KEY="openssl rand -base64 32"
# Only read once the sso module is installed, and required then under
# NODE_ENV=production: the public origin "<origin>/sso/callback" is built on.
# SSO_REDIRECT_BASE_URL="https://api.example.com"
# STORAGE_URL_SECRET="openssl rand -base64 32"

# Keys for `encrypted` blueprint fields and SecretsService, as a comma-separated
# list of <id>:<base64 key>, each key 32 bytes: "pnpm hery secrets:key" prints
# one. New values are sealed with the last key listed (or SECRETS_ACTIVE_KEY_ID),
# every key listed stays able to read what it sealed. To rotate: append a new
# key, run "pnpm hery secrets:rotate", then drop the old one. Left unset, a
# development key is used; NODE_ENV=production refuses to boot on it.
# SECRETS_KEYS="1:openssl rand -base64 32"
# SECRETS_ACTIVE_KEY_ID="1"

# BETTER_AUTH_SECRET is read by Better Auth itself, which throws in production
# rather than fall back, so it is not repeated in the framework env schema.
# BETTER_AUTH_SECRET="openssl rand -base64 32"

# Failed sign-ins in a row before an email is locked, and for how long. Unset,
# they are 5 attempts and 900 seconds.
# AUTH_LOCKOUT_MAX_ATTEMPTS="5"
# AUTH_LOCKOUT_SECONDS="900"
# Passwordless sign-in, each method off until set to "true". Turning one on adds
# its routes to the public /api/auth surface; see the authentication guide.
# AUTH_MAGIC_LINK_ENABLED="true"
# AUTH_EMAIL_OTP_ENABLED="true"
# AUTH_PHONE_OTP_ENABLED="true"
# AUTH_ANONYMOUS_ENABLED="true"
# AUTH_PASSKEY_ENABLED="true"
# AUTH_PASSKEY_RP_ID="example.com"
# AUTH_PASSKEY_ORIGIN="https://example.com"

# Read by the admin dashboard's browser bundle, not by the server -- it is the
# only variable declared in the public half of the env schema, and the only
# one the admin's client code is allowed to read. Left unset, it falls back to
# http://localhost:3000.
# PUBLIC_API_URL="http://localhost:3000"

# Optional overrides for "pnpm hery hosts" and the Caddy reverse proxy, useful
# when running more than one HeryJs checkout at the same time.
# HERYJS_DOMAIN="heryjs.local"
# HERYJS_APP_PORT="3000"
# HERYJS_HTTP_PORT="80"
# HERYJS_HTTPS_PORT="443"
# Platform operators: comma-separated user ids allowed to act above every
# tenant (global and cross-tenant feature flags, HTTP circuits, backups,
# metrics, health, deployment, cross-tenant quotas, the admin studio in
# production). Unset means nobody; a tenant admin is never an operator.
# PLATFORM_OPERATOR_IDS=""
