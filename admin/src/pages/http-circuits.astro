---
import Shell from '../layouts/Shell.astro';
---

<Shell title="HTTP circuits">
  <h1>HTTP circuits</h1>
  <p class="lede">
    One circuit per host the HTTP client has called. A host that keeps failing
    is cut off so calls fail fast instead of waiting; it is probed again after
    its cooldown. State is per instance.
  </p>

  <div class="output" id="output"></div>
</Shell>

<script>
  import { ApiError, api } from '../lib/api';
  import { icon, ICONS } from '../lib/icons';
  import { pill, skeleton, state } from '../lib/render';

  interface Circuit {
    host: string;
    state: string;
    consecutiveFailures: number;
    inFlight: number;
    retryAfterMs: number;
    rejectedByCircuit: number;
    rejectedByBulkhead: number;
    settings: {
      failureThreshold: number;
      openMs: number;
      halfOpenProbes: number;
      maxConcurrent: number;
    };
  }

  const TONES: Record<string, string> = {
    closed: 'ok',
    'half-open': 'warn',
    open: 'danger',
  };

  const output = document.getElementById('output')!;
  output.appendChild(skeleton(3));

  function button(label: string): HTMLButtonElement {
    const element = document.createElement('button');
    element.type = 'button';
    element.className = 'primary';
    element.append(icon(ICONS.refresh, 14), document.createTextNode(label));

    return element;
  }

  function number(value: number, label: string): HTMLInputElement {
    const input = document.createElement('input');
    input.type = 'number';
    input.min = '1';
    input.value = String(value);
    input.setAttribute('aria-label', label);

    return input;
  }

  async function post(
    host: string,
    action: string,
    body: Record<string, unknown>,
    result: HTMLElement,
  ): Promise<void> {
    result.textContent = 'Running…';

    try {
      await api<Circuit>(
        '/http-client/circuits/' + encodeURIComponent(host) + '/' + action,
        { method: 'POST', body: JSON.stringify(body) },
      );
      await load();
    } catch (error) {
      result.textContent = error instanceof ApiError ? error.message : 'Failed';
    }
  }

  function row(circuit: Circuit): HTMLElement {
    const card = document.createElement('div');
    card.className = 'card';

    const head = document.createElement('div');
    head.className = 'prune-row';

    const name = document.createElement('span');
    name.className = 'path';
    name.textContent = circuit.host;

    const counts = document.createElement('span');
    counts.className = 'mono';
    counts.textContent =
      circuit.consecutiveFailures +
      ' failures · ' +
      circuit.inFlight +
      ' in flight · ' +
      circuit.rejectedByCircuit +
      ' shed · ' +
      circuit.rejectedByBulkhead +
      ' over limit';

    const result = document.createElement('span');
    result.className = 'mono';

    const open = button('Open');
    open.disabled = circuit.state === 'open';
    open.addEventListener('click', () =>
      post(circuit.host, 'open', {}, result),
    );

    const reset = button('Close');
    reset.disabled = circuit.state === 'closed';
    reset.addEventListener('click', () =>
      post(circuit.host, 'reset', {}, result),
    );

    head.append(
      name,
      pill(circuit.state, TONES[circuit.state] ?? 'neutral'),
      counts,
      open,
      reset,
      result,
    );

    const tuning = document.createElement('div');
    tuning.className = 'prune-row';

    const threshold = number(circuit.settings.failureThreshold, 'Failures');
    const cooldown = number(circuit.settings.openMs, 'Cooldown in ms');
    const limit = number(circuit.settings.maxConcurrent, 'Concurrency limit');
    const save = button('Save limits');
    save.addEventListener('click', () =>
      post(
        circuit.host,
        'settings',
        {
          failureThreshold: Number(threshold.value),
          openMs: Number(cooldown.value),
          maxConcurrent: Number(limit.value),
        },
        result,
      ),
    );

    const caption = (text: string): HTMLElement => {
      const element = document.createElement('span');
      element.className = 'mono';
      element.textContent = text;

      return element;
    };

    tuning.append(
      caption('opens after'),
      threshold,
      caption('failures, cooldown ms'),
      cooldown,
      caption('max concurrent'),
      limit,
      save,
    );

    card.append(head, tuning);

    return card;
  }

  async function load(): Promise<void> {
    try {
      const { data } = await api<Circuit[]>('/http-client/circuits');

      output.replaceChildren(
        data.length === 0
          ? state(
              'No calls yet',
              'A host appears here the first time the HTTP client calls it.',
            )
          : (() => {
              const list = document.createElement('div');
              list.className = 'traces';
              list.append(...data.map(row));
              return list;
            })(),
      );
    } catch (error) {
      output.replaceChildren(
        error instanceof ApiError && error.status === 403
          ? state(
              'Not available',
              'Managing HTTP circuits is an admin-only operation.',
              'denied',
            )
          : state(
              'Could not load circuits',
              'The request to /http-client/circuits failed. Is the http-client module installed?',
              'denied',
            ),
      );
    }
  }

  await load();
</script>
