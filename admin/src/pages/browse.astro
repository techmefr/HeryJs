---
import Shell from '../layouts/Shell.astro';
---

<Shell title="Browse">
  <h1 id="heading">Browse</h1>
  <p class="route" id="route"></p>
  <div class="toolbar" id="global-actions"></div>
  <p class="notice" id="status" role="status" aria-live="polite"></p>

  <div class="output" id="output"></div>
</Shell>

<script>
  import { ApiError, api, labelOf, sectionsOf } from '../lib/api';
  import type { AdminSection } from '../lib/api';
  import {
    actionsForSection,
    actionsOf,
    runAdminAction,
  } from '../lib/admin-actions';
  import type { AdminActionRoute } from '../lib/admin-actions';
  import { loadControllers } from '../lib/introspection';
  import { adminIcon, icon, tintOf } from '../lib/icons';
  import { methodBadge, pill, skeleton, state, table } from '../lib/render';

  const heading = document.getElementById('heading')!;
  const output = document.getElementById('output')!;
  const status = document.getElementById('status')!;
  const toolbar = document.getElementById('global-actions')!;
  const params = new URLSearchParams(window.location.search);
  const route = params.get('path');
  const method = params.get('method') === 'POST' ? 'POST' : 'GET';

  const actionButton = (
    action: AdminActionRoute,
    onClick: () => void,
    suffix = '',
  ): HTMLButtonElement => {
    const button = document.createElement('button');
    button.type = 'button';
    button.append(icon(adminIcon(action.meta.icon, ''), 14));
    button.append(' ' + action.meta.title);
    button.setAttribute('aria-label', action.meta.title + suffix);

    if (action.meta.danger) {
      button.classList.add('danger');
    }

    button.addEventListener('click', onClick);

    return button;
  };

  if (!route) {
    output.appendChild(
      state('No section selected', 'Pick one in the sidebar to list its rows.'),
    );
  } else {
    const controllers = await loadControllers().catch(() => []);
    const section: AdminSection | undefined = sectionsOf(controllers).find(
      (candidate) => candidate.path === route && candidate.method === method,
    );
    const actions = actionsOf(controllers);

    const label =
      section?.label ??
      labelOf(method === 'POST' ? route.slice(0, -'/search'.length) : route);
    heading.textContent = label;
    document.title = label + ' — HeryJs admin';
    document.body.classList.add(tintOf(route));

    const crumb = document.getElementById('crumb');

    if (crumb) {
      crumb.textContent = label;
    }

    const target = document.getElementById('route')!;
    target.appendChild(methodBadge(method));
    target.appendChild(document.createTextNode(route));

    const load = async (): Promise<void> => {
      output.replaceChildren(skeleton());
      document.getElementById('top-extra')?.replaceChildren();

      try {
        const { data, meta } = await api<unknown>(
          route,
          method === 'POST'
            ? { method: 'POST', body: JSON.stringify({}) }
            : undefined,
        );
        const rows = (Array.isArray(data) ? data : [data]) as Record<
          string,
          unknown
        >[];
        const rowActions = section
          ? actionsForSection(actions, section, 'row')
          : [];

        output.replaceChildren(
          rows.length === 0
            ? state(
                'Nothing to show',
                'This section answered with an empty collection.',
              )
            : table(rows, {
                columns: section?.columns,
                actions:
                  rowActions.length === 0
                    ? undefined
                    : (row) => {
                        const cell = document.createElement('div');
                        cell.className = 'row-actions';

                        for (const action of rowActions) {
                          cell.appendChild(
                            actionButton(
                              action,
                              () => void run(action, { row }),
                              ' ' + String(row.id ?? ''),
                            ),
                          );
                        }

                        return cell;
                      },
              }),
        );

        // A paged listing shows one page: saying "25 rows" and stopping there
        // would read as "that is all there is", which is exactly what it is not.
        const window = meta as
          { page?: number; total?: number; last_page?: number } | undefined;
        const count =
          window?.total !== undefined && window.total > rows.length
            ? rows.length +
              ' of ' +
              window.total +
              ' rows — page ' +
              (window.page ?? 1) +
              ' of ' +
              (window.last_page ?? 1)
            : rows.length + (rows.length === 1 ? ' row' : ' rows');

        document
          .getElementById('top-extra')
          ?.appendChild(pill(count, 'neutral'));
      } catch (error) {
        output.replaceChildren(
          error instanceof ApiError && error.status === 403
            ? state(
                'A capability denied this listing',
                'The API refused to answer for the signed-in account. Nothing is hidden client side.',
                'denied',
              )
            : state(
                'Could not load this section',
                'The request to ' + route + ' failed.',
                'denied',
              ),
        );
      }
    };

    const run = async (
      action: AdminActionRoute,
      actionTarget: { row?: Record<string, unknown> },
    ): Promise<void> => {
      status.textContent = '';
      const outcome = await runAdminAction(
        document.querySelector('main')!,
        action,
        actionTarget,
      );

      if (outcome) {
        status.textContent = outcome.message;
        status.className = 'notice ' + (outcome.ok ? 'ok' : 'denied');

        if (outcome.ok) {
          await load();
        }
      }
    };

    if (section) {
      for (const action of actionsForSection(actions, section, 'global')) {
        toolbar.appendChild(actionButton(action, () => void run(action, {})));
      }
    }

    await load();
  }
</script>
